# Frontend Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or .env files to version control

# =============================================================================
# API CONFIGURATION (Required for production)
# =============================================================================
# Base URL for the backend API. Must include the full URL with protocol.
# Example: VITE_API_BASE_URL=https://your-backend-url.com/api
# For local development with Vite proxy, you can leave this empty or set to /api
VITE_API_BASE_URL=/api

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
# VITE_ENABLE_AI_EXPLANATIONS=true
# VITE_ENABLE_BLOCKCHAIN=true
# VITE_ENABLE_ML_ANOMALY=true